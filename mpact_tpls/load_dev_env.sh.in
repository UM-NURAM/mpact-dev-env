#!/bin/bash

# This file was automatically generated by @PROJECT_NAME@ v@PROJECT_VERSION@

# Check if the script has been loaded
if [[ -z "$MPACT_DEV_ENV" ]]; then

    # Set the variable to the directory containing the script
    export MPACT_DEV_ENV="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"

    #Define ROOT variables for TPLs used by MPACT build scripts
    export MPI_ROOT=${MPACT_DEV_ENV}/mpich-@MPICH_VERSION@
    export HDF5_ROOT=${MPACT_DEV_ENV}/hdf5-@HDF5_VERSION@
    export BLAS_ROOT=${MPACT_DEV_ENV}/lapack-@LAPACK_VERSION@
    export PETSC_DIR=${MPACT_DEV_ENV}/petsc-@PETSC_VERSION@
    export SLEPC_DIR=${MPACT_DEV_ENV}/slepc-@SLEPC_VERSION@

    #Add mpi and hdf5 to the path executables to path
    export PATH=$PATH:${MPI_ROOT}/bin
    export PATH=$PATH:${HDF5_ROOT}/bin
fi
